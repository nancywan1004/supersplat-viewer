{
  "name": "@playcanvas/supersplat-viewer",
  "version": "1.26.2",
  "author": "PlayCanvas <support@playcanvas.com>",
  "homepage": "https://github.com/playcanvas/supersplat-viewer#readme",
  "description": "Viewer for https://superspl.at",
  "keywords": [
    "playcanvas",
    "ply",
    "gaussian",
    "splat",
    "viewer"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playcanvas/supersplat-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/playcanvas/supersplat-viewer/issues"
  },
  "files": [
    "dist",
    "public",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@playcanvas/eslint-config": "2.1.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "ali-oss": "^6.23.0",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "express": "^4.18.2",
    "fflate": "^0.8.2",
    "globals": "17.6.0",
    "http-proxy-middleware": "^2.0.6",
    "mediabunny": "^1.30.1",
    "meshoptimizer": "^1.1.1",
    "playcanvas": "^2.20.0",
    "playwright": "^1.61.0",
    "postcss": "8.5.15",
    "publint": "0.3.21",
    "rollup": "4.61.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-obfuscator": "^1.1.0",
    "rollup-plugin-scss": "4.0.1",
    "rollup-plugin-string": "3.0.0",
    "sass": "1.100.0",
    "serve": "14.2.6",
    "typescript": "5.9.3",
    "zstddec": "^0.3.4"
  },
  "scripts": {
    "vendor:playcanvas": "curl -fsSL -o public/vendor/playcanvas-2.20.0.js \"https://cdn.jsdelivr.net/npm/playcanvas@2.20.0/+esm\"",
    "vendor:basis": "mkdir -p public/vendor/basis && BASE=https://raw.githubusercontent.com/playcanvas/engine/v2.20.0/examples/assets/wasm/basis && curl -fsSL -o public/vendor/basis/basis.js \"$BASE/basis.js\" && curl -fsSL -o public/vendor/basis/basis.wasm.js \"$BASE/basis.wasm.js\" && curl -fsSL -o public/vendor/basis/basis.wasm.wasm \"$BASE/basis.wasm.wasm\"",
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "build:prod:log": "NODE_ENV=production KEEP_CONSOLE=true rollup -c",
    "build:prod:obfuscate": "NODE_ENV=production OBFUSCATE=true rollup -c",
    "build:prod:with-types": "NODE_ENV=production GENERATE_TYPES=true rollup -c",
    "build:dev": "NODE_ENV=development rollup -c",
    "develop": "concurrently --kill-others \"npm run watch\" \"npm run serve\" \"npm run proxy\"",
    "lint": "eslint src rollup.config.mjs eslint.config.mjs",
    "lint:fix": "eslint src rollup.config.mjs eslint.config.mjs --fix",
    "publint": "publint",
    "proxy": "node scripts/proxy-server.js",
    "serve": "serve public -C -c ../serve.json",
    "benchmark:profile": "node scripts/benchmark-playwright.mjs public/benchmark-suites/scene-profiles.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "type:check": "tsc --noEmit",
    "watch": "rollup -c -w"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
